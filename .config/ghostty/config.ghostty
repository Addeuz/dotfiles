# Migrated from ~/.config/alacritty/alacritty.toml

# Theme: Cobalt2, copied from github.com/Addeuz/cobalt2.nvim (extras/ghostty) into themes/
theme = cobalt2

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 12

# Window
window-decoration = none
window-padding-balance = true

# Selection: copy to the system clipboard, not just the selection clipboard
copy-on-select = clipboard

